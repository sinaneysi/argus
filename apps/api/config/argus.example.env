# /etc/argus/argus.env: the non-secret configuration of one Argus installation (docs/architecture/CONFIG.md).
# KEY=value, one per line. No shell expansion: $HOME stays "$HOME". Quotes around a value are removed.
# The process environment wins over this file. Check it with:  argus config check
#
# argus and argus-api read the same keys. Print the effective values and their source with:  argus config show
# Old names still work and print a deprecation warning: OPS_DB -> ARGUS_DB, OPS_REPORT_BIND -> ARGUS_BIND,
# OPS_STATE_DIR / OPS_DATA_DIR -> ARGUS_STATE_DIR, ORG_NAME -> COMPANY_NAME, and the other OPS_* keys.
# Every key, its type and default: config/schema.json.
# Secrets do not belong here: put each one in its own file under ARGUS_SECRETS_DIR.

# --- required -------------------------------------------------------------------------------------------------------
COMPANY_NAME=Acme Retail
ARGUS_PUBLIC_URL=https://argus.acme.example

# --- core (the values below are the defaults) -------------------------------------------------------------------------
ARGUS_DISPLAY_NAME=Argus
ARGUS_HOSTNAME=argus-01
ARGUS_TZ=UTC
ARGUS_ETC_DIR=/etc/argus
ARGUS_SECRETS_DIR=/etc/argus/secrets
ARGUS_STATE_DIR=/var/lib/argus
# ARGUS_DB=/var/lib/argus/ops.db
# ARGUS_BOARD_DB=/var/lib/argus/board/board.db
# ARGUS_AUTH_DB=/auth/auth.db
# ARGUS_REPORTS_DIR=/opt/argus/reports/rca

# --- web app --------------------------------------------------------------------------------------------------------
ARGUS_BIND=127.0.0.1:8088
ARGUS_TRUSTED_PROXIES=127.0.0.1,::1
ARGUS_STALE_HOURS=25
ARGUS_ADMIN_USER=admin
# ARGUS_ADMINS=alex.doe,sam.roe

# --- single sign-on (all three, or none). The client secret is a secret: set it in the unit's environment
# --- from a credentials file, not here.
# OIDC_ISSUER=https://sso.acme.example/realms/acme
# OIDC_CLIENT_ID=argus

# --- collectors (argus checks <name>, argus worker): each is off until its flag is 1 ------------------------------
# alerts: Alertmanager (.../api/v2/alerts) or Prometheus (.../api/v1/alerts), one name=url per site
ARGUS_COLLECT_ALERTS=0
# ARGUS_ALERTS_SOURCES=east=https://alertmanager.east.acme.example/api/v2/alerts,west=https://prometheus.west.acme.example/api/v1/alerts
# ARGUS_ALERTS_TOKEN_FILE=/run/credentials/argus-checks@alerts.service/alerts-token
# certs: TLS handshake only; host or host:port (443)
ARGUS_COLLECT_CERTS=0
# ARGUS_CERT_TARGETS=www.acme.example,api.acme.example,mail.acme.example:465
# ARGUS_CERT_FILES=/etc/ssl/acme/wildcard.pem
ARGUS_CERT_WARN_DAYS=30
ARGUS_CERT_FAIL_DAYS=14
# backups: the sets in a JSON file (example: config/backup-sets.example.json)
ARGUS_COLLECT_BACKUPS=0
# ARGUS_BACKUP_SETS_FILE=/etc/argus/backup-sets.json

# --- public demo only ------------------------------------------------------------------------------------------------
DEMO_MODE=0

# --- notifications (argus notify, and every job that posts a notice) ------------------------------------------------
# Matrix first (only to MATRIX_NOTIFY_ROOM, never to a watched or alert room), else Telegram, else a webhook.
# The Matrix token lives in ARGUS_SECRETS_DIR/matrix-token (or ARGUS_MATRIX_TOKEN_FILE).
# ARGUS_NOTIFY_MATRIX=0
# MATRIX_HOMESERVER=https://matrix.acme.example
# MATRIX_NOTIFY_ROOM=!notices:acme.example
# MATRIX_WATCH_ROOMS=
# MATRIX_ALERT_ROOMS=

# --- task board sync (argus board sync, root; examples/systemd/argus-board-sync.*) ----------------------------------
# Jira settings live in the root-owned ARGUS_BOARD_ENV_FILES (JIRA_URL, JIRA_PROJECT, JIRA_ISSUE_TYPE, JIRA_JQL,
# JIRA_STATUS_MAP, JIRA_TRANSITIONS, JIRA_USER_MAP, JIRA_MODE, JIRA_COMPONENT, JIRA_CA_FILE), the token in
# ARGUS_BOARD_PAT_FILE (root 0600). Empty paths fall back to the settings directories and ARGUS_ETC_DIR.
# ARGUS_BOARD_SYNC=0
# ARGUS_BOARD_LABEL=argus
# ARGUS_BOARD_REF=ARG
