#!/bin/sh
# A fake Claude CLI: answers a task-agent prompt with a fixed plan in stream-json (no network).
if [ -n "${FAKE_CLAUDE_DUMP:-}" ]; then
  cat >"$FAKE_CLAUDE_DUMP"; cp lessons.md "$FAKE_CLAUDE_DUMP.lessons" 2>/dev/null || true
else
  cat >/dev/null
fi
case "${FAKE_CLAUDE_MODE:-plan}" in
  sleep) echo '{"type":"system","subtype":"init"}'; sleep 30 ;;
esac
echo '{"type":"system","subtype":"init"}'
echo '{"type":"assistant","message":{"content":[{"type":"tool_use","name":"Read","input":{"file_path":"'"$PWD"'/task.json"}}]}}'
echo '{"type":"assistant","message":{"content":[{"type":"tool_use","name":"Grep","input":{"pattern":"secret-arg"}}]}}'
printf '%s\n' '{"type":"result","is_error":false,"num_turns":3,"total_cost_usd":0.21,"duration_ms":900,"result":"Here is the plan:\n```json\n{\"classification\":{\"environment\":\"develop\",\"kind\":\"investigate\"},\"summary\":\"s\",\"plan\":[{\"text\":\"look\",\"mode\":\"read-only\"}]}\n```"}'
