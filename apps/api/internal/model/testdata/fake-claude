#!/bin/sh
# A fake Claude CLI for the tests and the clean install: answers in stream-json without a network.
# FAKE_CLAUDE_MODE: ok (default), error, nores, sleep, env. The prompt arrives on stdin.
prompt=$(cat)
case "${FAKE_CLAUDE_MODE:-ok}" in
  sleep) sleep 30 ;;
  nores) echo "boom: cannot reach the API" >&2; exit 1 ;;
esac
echo '{"type":"system","subtype":"init","session_id":"s1"}'
echo '{"type":"assistant","message":{"content":[{"type":"tool_use","name":"Read","input":{"file_path":"/w/task.json"}}]}}'
case "${FAKE_CLAUDE_MODE:-ok}" in
  error) echo '{"type":"result","subtype":"success","is_error":true,"result":"Invalid bearer token","num_turns":1,"total_cost_usd":0,"duration_ms":5}'; exit 1 ;;
  env) printf '{"type":"result","is_error":false,"result":"OK %s|%s|%s","num_turns":1,"total_cost_usd":0.01,"duration_ms":5}\n' "$CLAUDE_CODE_OAUTH_TOKEN" "${SECRET_OF_WORKER:-none}" "$(echo "$prompt" | head -c 16)" ;;
  *) echo '{"type":"result","subtype":"success","is_error":false,"result":"OK done https://git.example.test/g/p/-/merge_requests/7","num_turns":3,"total_cost_usd":0.12,"duration_ms":1500,"permission_denials":[{"tool_name":"Bash"}]}' ;;
esac
