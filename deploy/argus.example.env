# Argus settings for deploy/compose.yml (KEY=value, no shell expansion). Every key: argus config schema.
COMPANY_NAME=Example Company
ARGUS_PUBLIC_URL=https://argus.example.com
# the first admin; used once, at the first start (change it after signing in)
ARGUS_ADMIN_USER=admin
ARGUS_ADMIN_INITIAL_PASSWORD=change-me-at-first-sign-in
# the image already sets ARGUS_LAYOUT=volume and ARGUS_STATE_DIR=/var/lib/argus
# optional modules (off by default): marketing = search health, crawler traffic, search console, CDN
# ARGUS_MODULES=marketing
# the master key that encrypts the secrets in the volume (data-source logins, the Claude and Matrix tokens).
# Unset: created at the first start as keys/master.key inside the volume. Set it here (32 bytes, base64; print one
# with `argus secrets new-key`) to keep it outside the volume backup. Losing it means entering the secrets again.
# ARGUS_MASTER_KEY=
# the capability executor (ADR-0022), only with `docker compose --profile actions up -d`. Off by default: every
# action request is refused with a reason. dry-run: only the plan phase runs. Credentials never go here: use
# `docker compose exec -T actd argus actd credential set <family>/<name>` (the value on stdin).
# Approvals are signed by the api with its own key (volume argus-approve, created at the first start; never in this
# file: it is shared by every service). Give actd the public key once:
#   docker compose exec api /app/argus approval-key public | docker compose exec -T actd /app/argus actd approval-key set
# ARGUS_APPROVAL_KEY_DIR=/var/lib/argus-approve
# ARGUS_ACTIONS_MODE=off
# ARGUS_ACTIONS_APPROVAL_TTL=24h
# ARGUS_ACTIONS_PER_DAY=20
# ARGUS_ACTIONS_BACKUP_DAYS=30
# a write-tier capability runs only when the task's board labels hold one of these (and no other env: label) and
# the plan is classified develop: the model's label alone is not enough
# ARGUS_ACT_DEVELOP_LABELS=env:stage
# what the model provider learns about the allow-lists below: full (hosts, project paths, realms) or aliases
# ARGUS_ACT_CATALOGUE_DETAIL=full
# actd signs its heartbeat; pin its status key once so Settings can show it as verified:
#   docker compose exec -T actd /app/argus actd status-key public | docker compose exec -T api /app/argus approval-key trust-actd-status
# http.check: the hosts it may GET, [internal:]host[:port] (*.suffix allowed; no IP address, no bare *). Without a
# port only 443; without internal: a name that resolves to a private or loopback address is refused. Empty: off.
# ARGUS_ACT_HTTP_HOSTS=status.example.com,*.dev.example.com
# gitlab.ci-variable.get|set|delete: project CI/CD variables of scope develop only, of these projects (ids or
# group/project paths). The group access token is never here: give it to actd only, then pin actd's sealing key:
#   docker compose exec -T actd /app/argus actd credential set gitlab/token          (the token on stdin)
#   docker compose exec -T actd /app/argus actd seal-key public | docker compose exec -T api /app/argus approval-key trust-actd
# ARGUS_ACT_GITLAB_URL=https://gitlab.example.com
# ARGUS_ACT_GITLAB_PROJECTS=group/app,1234
# keycloak.read: read-only admin queries (users, user, ldap-mappers, client-scopes) of these realms. A confidential
# client with a service account and only the realm-management roles view-users, view-realm, query-clients (see
# docs/architecture/CONFIG.md). The client secret is never here: give it to actd only:
#   docker compose exec -T actd /app/argus actd credential set keycloak/client         (the secret on stdin)
# ARGUS_ACT_KEYCLOAK_URL=https://id.example.com
# ARGUS_ACT_KEYCLOAK_REALMS=example
# ARGUS_ACT_KEYCLOAK_CLIENT_ID=argus-read
# the realm the client lives in; it always gets the token request. Required with several realms (normally master);
# empty: the only realm above
# ARGUS_ACT_KEYCLOAK_CLIENT_REALM=
# the most user-returning queries (users, user) one action may run (1..50)
# ARGUS_ACT_KEYCLOAK_MAX_READS=5
