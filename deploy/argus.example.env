# Argus settings for deploy/compose.yml (KEY=value, no shell expansion). Every key: argus config schema.
COMPANY_NAME=Example Company
ARGUS_PUBLIC_URL=https://argus.example.com
# the first admin; used once, at the first start (change it after signing in)
ARGUS_ADMIN_USER=admin
ARGUS_ADMIN_INITIAL_PASSWORD=change-me-at-first-sign-in
# the image already sets ARGUS_LAYOUT=volume and ARGUS_STATE_DIR=/var/lib/argus
# optional modules (off by default): marketing = search health, crawler traffic, search console, CDN
# ARGUS_MODULES=marketing
# the master key that encrypts the secrets in the volume (data-source logins, the Claude and Matrix tokens).
# Unset: created at the first start as keys/master.key inside the volume. Set it here (32 bytes, base64; print one
# with `argus secrets new-key`) to keep it outside the volume backup. Losing it means entering the secrets again.
# ARGUS_MASTER_KEY=
